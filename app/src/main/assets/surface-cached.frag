precision highp float;varying vec2 world;uniform sampler2D fieldTexture;uniform float aa;uniform float junctionMask;uniform vec3 blue;uniform vec3 accent;uniform vec3 warm;uniform vec3 gold;void main(){vec4 texelValue=texture2D(fieldTexture,vec2(world.x/800.,1.-world.y/450.));float distance=(texelValue.r+texelValue.g/255.)*128.-64.;if(junctionMask>.5){if(texelValue.a<.18||distance>-4.)discard;gl_FragColor=vec4(1.);return;}float coverage=1.-smoothstep(1.4-aa,1.4+aa,distance);if(coverage<.001)discard;vec3 material=texelValue.b>.75?mix(blue,warm,.58):texelValue.b>.25?mix(blue,warm,.32):mix(blue,accent,.22);float rim=smoothstep(-1.4-aa,-1.4+aa,distance);gl_FragColor=vec4(mix(material,gold,rim),coverage);}

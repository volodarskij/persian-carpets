precision mediump float;varying vec4 ink;varying vec4 motif;uniform float lodScale;void main(){if(motif.z>.5){float rr=dot(motif.xy,motif.xy);float r=sqrt(rr);float nx=motif.x*inversesqrt(max(rr,.0001));float c3=nx*(4.*nx*nx-3.);float edge=.66+.16*(2.*c3*c3-1.);float aa=clamp(.9/max(motif.w*lodScale,1.),.08,.40);float coverage=1.-smoothstep(edge-aa,edge+aa,r);vec3 color=mix(ink.rgb*(.72+.28*smoothstep(.1,.5,r)),vec3(1.,.86,.38),1.-smoothstep(.12,.25,r));gl_FragColor=vec4(color,coverage*.46*smoothstep(.45,1.4,motif.w*lodScale));}else{gl_FragColor=ink;}if(gl_FragColor.a<.02)discard;}
